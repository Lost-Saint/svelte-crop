{
  "name": "svelte-crop",
  "version": "0.0.1",
  "description": "A Svelte component to crop images with easy interactions",
  "homepage": "https://github.com/Lost-Saint/svelte-crop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lost-Saint/svelte-crop"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "author": "lost-saint",
  "license": "GLWTS",
  "keywords": [
    "svelte",
    "image crop",
    "cropper"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && dprint check",
    "format": "dprint fmt",
    "package": "svelte-package",
    "test": "bun run unit && bun run e2e",
    "unit": "vitest run",
    "e2e": "playwright test",
    "test:unit": "bun run unit",
    "test:e2e": "bun run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^22",
    "dprint": "^0.61.1",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "publint": "^0.3.21",
    "query-string": "^8.1.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "svelte": "^5.29.0"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
