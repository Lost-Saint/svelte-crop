{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "includes": ["src/**/*.svelte"],
  "excludes": [
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/build/**",
    "**/dist/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ],
  "plugins": [
    "npm:dprint-plugin-markup@0.27.5",
    "npm:@dprint/typescript@0.96.1",
    "npm:dprint-plugin-malva@0.16.0"
  ],
  "lineWidth": 100,
  "indentWidth": 4,
  "useTabs": true,
  "markup": {
    "scriptIndent": true
  },
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "preferSingle"
  }
}
